{
  "name": "@radicalbit/formbit",
  "version": "3.0.0",
  "description": "Lightweight state form library",
  "author": "https://github.com/radicalbit",
  "license": "MIT",
  "repository": "https://github.com/radicalbit/formbit",
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "microbundle-crl --no-compress --format modern,cjs",
    "start": "microbundle-crl watch --no-compress --format modern,cjs",
    "prepare": "run-s build && husky",
    "test": "run-s test:unit test:lint test:build",
    "test:build": "run-s build",
    "test:lint": "eslint .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "predeploy": "cd example && yarn install && yarn run build",
    "deploy": "gh-pages -d example/build",
    "yalc:publish": "yalc publish --push --sig",
    "docs:gen": "typedoc --excludePrivate --excludeInternal --plugin typedoc-plugin-markdown --out docs src/types/index.ts",
    "docs:merge": "node scripts/readme-merge.js",
    "docs:toc": "doctoc --maxlevel 3 README.md --github",
    "docs:clean": "rimraf docs",
    "docs": "yarn docs:gen && yarn docs:merge && yarn docs:toc && yarn docs:clean"
  },
  "peerDependencies": {
    "lodash": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "doctoc": "^2.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lodash": "^4.17.21",
    "microbundle-crl": "^0.13.11",
    "neostandard": "^0.13.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "uuid": "^14.0.2",
    "yup": "^1.7.1"
  },
  "resolutions": {
    "**/typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ]
}
